# --- Anthropic (генерация ответов) ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5

# --- Эмбеддинги ---
# local  — ONNX-модель all-MiniLM-L6-v2 внутри chromadb (без внешних вызовов)
# voyage — Voyage AI (рекомендованный Anthropic провайдер эмбеддингов)
EMBEDDINGS_PROVIDER=local
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3

# --- Хранилище ---
CHROMA_DIR=./data/chroma
UPLOAD_DIR=./data/uploads

# --- Доступ в админку ---
ADMIN_TOKEN=change-me-please

# --- Параметры поиска и нарезки ---
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
TOP_K=6
